# Redis (TCP). Required.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
# Remote hosts default to TLS. Set false only for a configured TCP-only Redis endpoint.
REDIS_TLS=

# Key prefix so development and production data do not collide.
REDIS_KEY_PREFIX=proofline:dev

APP_URL=http://localhost:3000

# OpenAI is required for Phase 2. Search uses the same key by default.
# Model id is not set here. Proofline uses GPT 5.5 from src/lib/model-config.ts.
OPENAI_API_KEY=
SEARCH_API_KEY=
SEARCH_PROVIDER=openai

MAX_SOURCES_PER_RUN=18
MAX_CLAIMS_PER_RUN=30
MAX_CONCURRENT_FETCHES=3
RUN_RETENTION_SECONDS=2592000
